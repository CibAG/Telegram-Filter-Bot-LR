# Шаблон переменных окружения. Скопируйте в .env и заполните реальными значениями.
# Файл .env добавлен в .gitignore и не должен попадать в репозиторий.

# Telegram-бот
BOT_TOKEN=your_bot_token_here
# Числовые Telegram ID администраторов через запятую (обязательно заполнить)
ADMIN_IDS=

# База данных
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
LOG_LEVEL=INFO

# Модерация
IGNORE_ADMIN_MESSAGES=true
WARN_ON_DELETE=false
WARN_TTL_SECONDS=5

# OpenRouter (https://openrouter.ai) — доступ к AI-моделям через один API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
AI_MAX_HISTORY=20
# Необязательно: отдельная модель и таймаут для AI-модерации
AI_MODERATION_MODEL=
AI_MODERATION_TIMEOUT=20
AI_MODERATION_ERROR_COOLDOWN=300
